  "repository": {
    "type": "git",
    "url": ""
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {},
  "dependencies": {
    "@llmux/core": "workspace:*"
  }

}
